# Copie para ".env" e ajuste os valores

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tchardwarepred

# Integração com o 3DMark: manual | local_export | api
THREEDMARK_PROVIDER=manual

# Usado somente se THREEDMARK_PROVIDER=local_export
THREEDMARK_EXPORT_DIR=./3dmark_exports

# Usado somente se THREEDMARK_PROVIDER=api (requer acesso B2B junto à UL Solutions)
THREEDMARK_API_BASE_URL=
THREEDMARK_API_KEY=
